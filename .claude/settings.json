{
  "permissions": {
    "allow": [
      "Bash(git commit*)",
      "Bash(git stash*)",
      "Bash(git branch*)",
      "Bash(git push*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git status*)",
      "Bash(.venv/Scripts/python.exe -m pytest*)",
      "Bash(.venv/Scripts/python.exe -m py_compile*)",
      "Bash(.venv/Scripts/python.exe sim_verify.py*)",
      "Bash(.venv/Scripts/python.exe tests/replay_motor_trace.py*)",
      "Bash(PYTHONIOENCODING=utf-8 .venv/Scripts/python.exe*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python .claude/hooks/hook_validate_command.py",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python .claude/hooks/hook_syntax_check.py",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python .claude/hooks/hook_session_log.py",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
