[Unit]
Description=CANSAT AAS 2026 Flight Software
After=network.target

[Service]
Type=simple
# Default root so DietPi / minimal images without the "pi" user do not fail with status=217/USER.
# For Raspberry Pi OS as user pi: set User=pi (or run setup_systemd_service.sh — it can rewrite User=).
User=root
WorkingDirectory=/opt/cansat-fsw
ExecStart=/opt/cansat-fsw/startup.sh
Restart=on-failure
RestartSec=3
KillSignal=SIGINT
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
