[Unit]
Description=CANSAT Flight Software
After=network.target pigpiod.service

[Service]
Type=simple
User=root
WorkingDirectory=/root/CANSAT_AAS_2026_FSW
Environment="PATH=/root/venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
ExecStart=/bin/bash /root/CANSAT_AAS_2026_FSW/startup.sh
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target

