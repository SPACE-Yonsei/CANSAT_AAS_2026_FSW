[Unit]
Description=CANSAT AAS 2026 Flight Software
After=network.target

[Service]
Type=simple
# Replaced by setup_systemd_service.sh (default: repo owner or SUDO_USER; DietPi often root/dietpi, not pi).
User=pi
WorkingDirectory=/opt/cansat-fsw
ExecStart=/opt/cansat-fsw/startup.sh
Restart=on-failure
RestartSec=3
KillSignal=SIGINT
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
