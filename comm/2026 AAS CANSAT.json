    "frameEnd": "\r",
    "frameParser": "// Lost-packet tracker (closure, persists across frames)\nvar _prevPktCount = -1;\nvar _lostCount = 0;\n\nfunction parse(frame) {\n    try {\n        if (typeof frame !== 'string') return [];\n        frame = frame.replace(/[\\r\\n]+$/, '');\n        if (frame.length > 0 && frame.charAt(0) === '$') {\n            frame = frame.substring(1);\n        }\n        var result = frame.split(',');\n        for (var i = 0; i < result.length; i++) {\n            result[i] = String(result[i] || '').trim();\n        }\n        // PACKET_COUNT is field index 2 (0-based after $ strip)\n        // Calculate lost = gaps in PACKET_COUNT sequence\n        try {\n            var cur = parseInt(result[2], 10);\n            if (!isNaN(cur)) {\n                if (_prevPktCount < 0 || cur <= _prevPktCount) {\n                    // 최초 수신 또는 CAL 리셋 감지\n                    _lostCount = 0;\n                } else if (cur > _prevPktCount + 1) {\n                    _lostCount += cur - _prevPktCount - 1;\n                }\n                _prevPktCount = cur;\n            }\n        } catch(e) {}\n        result.push(String(_lostCount));\n        return result;\n    } catch (e) {\n        return [];\n    }\n}\n",
