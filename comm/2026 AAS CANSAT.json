    "frameEnd": "\n",
    "frameParser": "/**\n * Splits a data frame into an array of elements using a comma separator.\n * Handles empty fields and trims whitespace safely.\n *\n * @param[in]  frame   A string containing the data frame.\n *                     Example: \"value1,value2,value3\"\n *\n * @return     An array of strings with the split elements.\n *             Example: [\"value1\", \"value2\", \"value3\"]\n *\n * @note Empty fields are preserved as empty strings.\n */\nfunction parse(frame) {\n    try {\n        // Safety check: ensure frame is a string\n        if (typeof frame !== 'string') {\n            return [];\n        }\n        // Remove trailing newline if present\n        frame = frame.replace(/\\r?\\n$/, '');\n        // CANSAT TLM lines start with \"$\" (e.g. \"$1070,...\")\n        if (frame.length > 0 && frame.charAt(0) === '$') {\n            frame = frame.substring(1);\n        }\n        // Split by comma and return array\n        var result = frame.split(',');\n        // Trim whitespace from each element and ensure all elements are strings\n        for (var i = 0; i < result.length; i++) {\n            result[i] = String(result[i] || '').trim();\n        }\n        return result;\n    } catch (e) {\n        // Return empty array on any error to prevent crash\n        return [];\n    }\n}\n",
